#Optional: Set to production in prod
NODE_ENV=development

# Server URLs (replace with your domains)
VITE_API_URL_DEV=http://localhost:3001
VITE_API_URL_PROD=https://api.yourdomain.com

# Sentry credentials
VITE_SENTRY_DNS=your_sentry_dns
# .env.sentry-build-plugin
SENTRY_ORG=your_sentry_organization
SENTRY_PROJECT=your_sentry_project
SENTRY_AUTH_TOKEN=your_sentry_authentication_token